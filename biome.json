{
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false,
                "source": [":NODE:", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": ":ALIAS:"
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": ":PATH:"
              },
              ":BLANK_LINE:",
              { "type": true }
            ],
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  },
  "files": {
    "includes": ["**/*"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": "off",
      "complexity": {
        "noVoid": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useImportExtensions": "warn"
      },
      "style": {
        "useImportType": {
          "level": "warn",
          "options": {
            "style": "separatedType"
          }
        }
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  }
}
